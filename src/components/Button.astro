---
interface Props {
  variant?: 'primary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  className?: string;
  ariaLabel?: string;
}

const { variant = 'primary', size = 'md', href, type = 'button', className = '', ariaLabel }: Props = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-medium transition-colors disabled:opacity-50 disabled:pointer-events-none';

let variantClass = '';
if (variant === 'primary') {
  variantClass = 'bg-[#382172] text-white hover:bg-[#2a1754]';
} else if (variant === 'outline') {
  variantClass = 'border border-line text-body hover:border-accent hover:text-accent';
} else {
  variantClass = 'text-body hover:text-accent underline underline-offset-4';
}

let sizeClass = '';
if (size === 'sm') {
  sizeClass = 'px-3 py-1.5 text-sm';
} else if (size === 'md') {
  sizeClass = 'px-4 py-2 text-sm';
} else {
  sizeClass = 'px-5 py-2.5 text-base';
}

const classes = `${base} ${variantClass} ${sizeClass} ${className}`;
---

{href ? (
  <a href={href} class={classes} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} aria-label={ariaLabel}>
    <slot />
  </button>
)}

---
import Icon from './Icon.astro';

interface Props {
  name: string;
  title: string;
  description: string;
  tags: string[];
  install: string;
  icon: string;
  topic?: string;
}
const { name, title, description, tags, install, icon, topic }: Props = Astro.props;
const searchText = [name, title, description, ...tags].join(' ').toLowerCase();
---

<article
  class="group flex h-full flex-col border-t-2 border-accent bg-surface p-5 transition-all duration-300 hover:-translate-y-1 hover:bg-surface-strong hover:shadow-[0_8px_30px_rgb(var(--accent-fill)/0.2)]"
  data-skill-card
  data-topic={topic}
  data-search={searchText}
>
  <a href={`/skills/${name}`} class="flex items-start gap-3">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-accent-fill text-accent">
      <Icon name={icon} size={20} />
    </span>
    <span class="min-w-0">
      <span class="block text-sm font-semibold leading-tight text-heading">{title}</span>
      <span class="mt-0.5 block truncate font-mono text-xs text-subtle">{name}</span>
    </span>
  </a>

  <p class="mt-3 text-sm leading-relaxed text-body line-clamp-3">{description}</p>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <span class="border border-line bg-base px-2 py-0.5 font-mono text-[11px] text-subtle transition-colors hover:border-accent hover:text-accent">
        {tag}
      </span>
    ))}
  </div>

  <div class="mt-4 flex items-center gap-2 border border-line bg-base py-2 pl-3 pr-2">
    <span aria-hidden="true" class="select-none text-accent">$</span>
    <code class="min-w-0 flex-1 truncate font-mono text-xs text-body">{install}</code>
    <button
      type="button"
      data-copy
      data-copy-text={install}
      class="p-1.5 text-subtle transition-colors hover:text-accent"
      aria-label={`Salin perintah instal ${title}`}
    >
      <span data-copy-icon-copy><Icon name="copy" size={16} /></span>
      <span data-copy-icon-done class="hidden text-accent"><Icon name="check" size={16} /></span>
    </button>
  </div>
</article>
